<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chữ -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>
    <style name="TextAppearance.App.Label" parent="TextAppearance.App.Caption">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card trắng bo góc lớn, viền mảnh + bóng rất nhẹ -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">2dp</item>
    </style>
    <!-- Card phẳng có viền: màu viền gán theo nhóm trong code -->
    <style name="Widget.App.Card.Outlined" parent="Widget.App.Card">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/stroke</item>
    </style>

    <!-- Ô nhập nền nhạt, viền mảnh; viền cam khi focus -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxBackgroundColor">@color/field</item>
        <item name="boxStrokeColor">@color/stroke_input</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="errorTextColor">@color/error</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <!-- Nút cam, bóng đổ màu cam -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/icon_circle</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor">@color/accent</item>
        <item name="android:outlineAmbientShadowColor">@color/accent</item>
    </style>
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="strokeColor">@color/accent_mid</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">@dimen/icon_circle</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Nút icon tròn trắng, vùng bấm 48dp -->
    <style name="Widget.App.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Chip lọc: chọn = nền cam chữ trắng; chưa chọn = trắng viền mảnh -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipIconTint">@color/chip_icon</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.App.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Ô icon tròn nhỏ ở các dòng thông tin -->
    <style name="Widget.App.InfoIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:scaleType">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Lựa chọn giới tính dạng pill -->
    <style name="Widget.App.GenderPill" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/space_xs</item>
        <item name="android:background">@drawable/bg_pill_selector</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/gender_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Icon tròn nền cam nhạt bên trái mỗi trường của form -->
    <style name="Widget.App.RowIcon" parent="Widget.App.InfoIcon">
        <item name="android:backgroundTint">@color/accent_soft</item>
        <item name="android:layout_marginTop">22dp</item>
    </style>
</resources>
