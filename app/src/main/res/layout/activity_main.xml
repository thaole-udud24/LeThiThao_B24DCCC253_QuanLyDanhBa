<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- Giới hạn bề ngang nội dung và căn giữa trên tablet / landscape -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/coordinator"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="@dimen/main_max_width">

    <!-- Header cuộn đi khi kéo danh sách để dành chỗ trên màn hình nhỏ / landscape -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/screen_padding"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Lời chào + nút tròn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUserAvatar"
                    style="@style/TextAppearance.App.Title"
                    android:layout_width="@dimen/icon_circle"
                    android:layout_height="@dimen/icon_circle"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/accent_soft"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/TextAppearance.App.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2" />

                    <TextView
                        style="@style/TextAppearance.App.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/main_subtitle" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSort"
                    style="@style/Widget.App.IconButton"
                    android:contentDescription="@string/cd_sort" />

                <ImageButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.App.IconButton"
                    android:layout_marginStart="@dimen/space_s"
                    android:contentDescription="@string/cd_logout" />
            </LinearLayout>

            <!-- Thẻ thống kê: nền cam nhạt + hình tròn trang trí; MaterialCardView bo tròn và cắt hình trang trí -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                app:cardBackgroundColor="@color/hero_bg"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-50dp"
                        android:layout_marginBottom="-70dp"
                        android:background="@drawable/bg_blob_dark"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="64dp"
                        android:layout_marginBottom="-60dp"
                        android:background="@drawable/bg_blob_dark"
                        android:importantForAccessibility="no" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_l">

                        <ImageView
                            android:id="@+id/imgStatTotal"
                            style="@style/Widget.App.InfoIcon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Nhãn nằm dưới icon, được xuống dòng đúng từ khi chữ hệ thống lớn -->
                        <TextView
                            android:id="@+id/tvTotalLabel"
                            style="@style/TextAppearance.App.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:text="@string/stat_total"
                            android:textSize="@dimen/text_body"
                            app:layout_constraintEnd_toStartOf="@id/ring"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgStatTotal" />

                        <TextView
                            android:id="@+id/tvTotal"
                            style="@style/TextAppearance.App.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textSize="@dimen/text_stat"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvTotalLabel" />

                        <FrameLayout
                            android:id="@+id/ring"
                            android:layout_width="@dimen/ring_size"
                            android:layout_height="@dimen/ring_size"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressFavorites"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:indeterminate="false"
                                android:max="100"
                                app:indicatorColor="@color/accent"
                                app:indicatorSize="88dp"
                                app:trackColor="@color/ring_track"
                                app:trackCornerRadius="8dp"
                                app:trackThickness="10dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvFavorites"
                                    style="@style/TextAppearance.App.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stat_favorite"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    app:autoSizeMaxTextSize="11sp"
                                    app:autoSizeMinTextSize="4sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />

                                <ImageView
                                    android:id="@+id/imgStatStar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no" />
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tìm kiếm -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/hint_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lọc theo nhóm / yêu thích (icon gắn trong code) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_favorite" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFamily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/group_family" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFriends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/group_friends" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/group_work" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/group_other" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="96dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_l"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgEmpty"
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/accent_soft"
                android:importantForAccessibility="no"
                android:scaleType="center" />

            <TextView
                style="@style/TextAppearance.App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/empty_title" />

            <TextView
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/empty_message" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/cd_add"
        android:text="@string/cd_add"
        android:textColor="@color/white"
        app:backgroundTint="@color/accent"
        app:elevation="6dp"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Fab" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
